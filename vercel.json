{
  "headers": [
    { "source": "/sw.js", "headers": [ { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }, { "key": "Service-Worker-Allowed", "value": "/" } ] },
    { "source": "/(index.html|app.js|style.css|manifest.webmanifest)", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] },
    { "source": "/data/(.*)", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] },
    { "source": "/img/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=2592000" } ] }
  ]
}
